              "id": "w06stats",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px;\"><div style=\"background:#f1f5f9;border-radius:12px;padding:20px;\"><div style=\"font-size:26px;font-weight:800;color:#1e40af;\">500+</div><div style=\"font-size:13px;color:#64748b;margin-top:4px;\">Kurse getestet</div></div><div style=\"background:#f1f5f9;border-radius:12px;padding:20px;\"><div style=\"font-size:26px;font-weight:800;color:#1e40af;\">700.000&nbsp;&euro;+</div><div style=\"font-size:13px;color:#64748b;margin-top:4px;\">eigener Umsatz durch dig. Angebote</div></div><div style=\"background:#f1f5f9;border-radius:12px;padding:20px;\"><div style=\"font-size:26px;font-weight:800;color:#1e40af;\">2021</div><div style=\"font-size:13px;color:#64748b;margin-top:4px;\">Gr&uuml;ndungsjahr</div></div><div style=\"background:#f1f5f9;border-radius:12px;padding:20px;\"><div style=\"font-size:26px;font-weight:800;color:#1e40af;\">100&nbsp;%</div><div style=\"font-size:13px;color:#64748b;margin-top:4px;\">unabh&auml;ngige Bewertungen</div></div></div>"
